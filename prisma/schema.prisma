generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues    Issue[]
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Issue {
  id          Int           @id @default(autoincrement())
  title       String
  description String?
  status      IssueStatus   @default(OPEN)
  severity    IssueSeverity @default(MEDIUM)
  createdAt   DateTime      @default(now())

  userId      Int
  user        User          @relation(fields: [userId], references: [id])

  logs        LogEntry[]
  tags        Tag[]

  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@index([userId])
}

model LogEntry {
  id        Int      @id @default(autoincrement())

  rawText   String
  source    String

  createdAt DateTime @default(now())

  issueId   Int
  issue     Issue    @relation(fields: [issueId], references: [id])
}

model Summary {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
}

model Tag {
  id      Int    @id @default(autoincrement())
  name    String
  issues  Issue[]
}